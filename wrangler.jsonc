{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cartrack-dashcam-landingpage",
  "account_id": "8e5c9c94197c950548bd0e188beb0007",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "reports.bestcardash.com",
      "custom_domain": true,
    },
    {
      "pattern": "bestcardash.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cartrack-dashcam-landingpage",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cartrack_dashcam_landing",
      "database_id": "f90b223b-d425-45b8-9260-f7b9e30a612c",
      "migrations_dir": "migrations",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "LEAD_QUEUE",
        "queue": "bestcardash-leads",
      },
    ],
    "consumers": [
      {
        "queue": "bestcardash-leads",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "bestcardash-leads-dlq",
      },
      {
        "queue": "bestcardash-leads-dlq",
        "max_batch_size": 10,
        "max_retries": 100,
        "retry_delay": 300,
      },
    ],
  },
  "triggers": {
    "crons": ["17 2 * * *", "*/5 * * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "DEPLOY_PLATFORM": "cloudflare",
    "DEPLOY_ENV": "production",
    "NEXT_PUBLIC_SITE_URL": "https://bestcardash.com",
    "SITE_INDEXABLE": "true",
    "LEADBYTE_ENABLED": "true",
    "GOOGLE_ADS_FORM_MAPPINGS": "{}",
    "RATE_LIMIT_MAX": "10",
    "RATE_LIMIT_WINDOW_SECONDS": "600",
  },
}
